rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isStaff() {
      return signedIn()
        && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isStaff == true
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.panels.size() > 0))
          || (request.auth.token.email != null
            && exists(/databases/$(database)/documents/users/$(request.auth.token.email))
            && (get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.isStaff == true
              || get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.panels.size() > 0))
        );
    }

    function hasPanel(panel) {
      return isStaff() && (
        panel in ['myDashboard', 'myPerformance', 'myTasks']
        ||
        (request.auth.token.email != null
          && exists(/databases/$(database)/documents/users/$(request.auth.token.email))
          && panel in get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.panels)
        || (request.auth.token.email == null
          || !exists(/databases/$(database)/documents/users/$(request.auth.token.email)))
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && panel in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.panels
      );
    }

    function canManagePerformance() {
      return isAdmin() || hasPanel('performance');
    }

    function canWorkOnTasks() {
      return isAdmin() || hasPanel('tasks') || hasPanel('myTasks');
    }

    function canCreatePersonalTask() {
      let plan = request.resource.data;
      let feature = plan.features[0];
      let task = plan.tasks[0];
      let workflow = plan.taskWorkflow[feature];
      return hasPanel('myTasks')
        && plan.keys().hasOnly(['clientId', 'templateId', 'type', 'name', 'price',
          'features', 'tasks', 'completedFeatures', 'featureProgress', 'taskWorkflow',
          'startDate', 'endDate'])
        && plan.type == 'setup'
        && plan.price == 0
        && plan.templateId == null
        && plan.endDate == null
        && plan.startDate is timestamp
        && plan.clientId is string
        && (plan.clientId == '__internal_practice__'
          || exists(/databases/$(database)/documents/clients/$(plan.clientId)))
        && plan.name in ['Custom Tasks', 'Practice (Internal)']
        && ((plan.clientId == '__internal_practice__') == (plan.name == 'Practice (Internal)'))
        && plan.features is list && plan.features.size() == 1
        && feature is string
        && plan.tasks is list && plan.tasks.size() == 1
        && task.keys().hasOnly(['id', 'category', 'title', 'instructions', 'order',
          'source', 'templateTaskId', 'addedReason'])
        && task.id is string && task.id.size() > 0
        && task.templateTaskId == null
        && task.category is string && !task.category.matches('^Sales($| / .*)')
        && task.title is string && task.title.size() > 0
        && feature == task.category + ': ' + task.title
        && task.source == 'customIncluded'
        && task.order == 0
        && task.addedReason is string && task.addedReason.size() > 0
        && plan.completedFeatures is list && plan.completedFeatures.size() == 0
        && plan.featureProgress is map && plan.featureProgress.size() == 0
        && plan.taskWorkflow is map && plan.taskWorkflow.keys().hasOnly([feature])
        && workflow.keys().hasOnly(['assignedTo', 'assignedToName', 'priority',
          'updatedAt', 'dueAt', 'internalNotes', 'createdAt', 'createdBy',
          'assignedAt', 'assignedBy', 'dueBy'])
        && workflow.assignedTo is string
        && workflow.assignedTo in [request.auth.uid, request.auth.token.email];
    }

    match /{path=**}/conversations/{conversationId} {
      allow read: if isAdmin() || hasPanel('chat');
    }

    match /chat_stats/{documentId} {
      allow read: if isAdmin() || hasPanel('chat');
    }

    match /users/{userId} {
      allow create: if signedIn() && (
        isAdmin()
        || (request.auth.uid == userId
            && request.resource.data.isAdmin == false
            && request.resource.data.panels.size() == 0)
      );
      allow read: if signedIn() && (
        request.auth.uid == userId
        || request.auth.token.email == userId
        || isAdmin()
        || hasPanel('users')
        || hasPanel('tasks')
        || hasPanel('performance')
      );
      allow update: if signedIn()
        && (
          isAdmin()
          || hasPanel('users')
          || (request.auth.uid == userId
              && request.resource.data.isAdmin == resource.data.isAdmin
              && request.resource.data.panels == resource.data.panels)
        );
      allow delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if isAdmin()
        || hasPanel('leads')
        || hasPanel('clients')
        || hasPanel('plans')
        || hasPanel('tasks')
        || hasPanel('myTasks');
      allow write: if isAdmin() || hasPanel('leads') || hasPanel('clients');

      match /salesActivity/{entryId} {
        allow read: if isAdmin()
          || hasPanel('leads') || hasPanel('clients')
          || hasPanel('plans') || hasPanel('tasks') || hasPanel('myTasks');
        allow create: if (isAdmin() || hasPanel('leads') || hasPanel('clients'))
          && request.resource.data.recordedBy == request.auth.uid
          && request.resource.data.id == entryId;
        allow update, delete: if false;
      }

      match /conversations/{conversationId} {
        allow read, write: if isAdmin() || hasPanel('chat');

        match /messages/{messageId} {
          allow read, write: if isAdmin() || hasPanel('chat');
        }
      }

      match /contacts/{contactId} {
        allow read: if isAdmin() || hasPanel('chat');
        allow write: if isAdmin() || hasPanel('chat');
      }

      match /{collection}/{document}/{rest=**} {
        allow read: if isAdmin() || hasPanel('clients');
        allow write: if collection != 'salesActivity'
          && (isAdmin() || hasPanel('clients'));
      }
    }

    match /plans/{planId} {
      allow read: if isAdmin()
        || hasPanel('myDashboard')
        || hasPanel('plans')
        || hasPanel('tasks')
        || hasPanel('myTasks');
      allow create: if isAdmin() || hasPanel('plans') || hasPanel('tasks')
        || canCreatePersonalTask();
      allow delete: if isAdmin() || hasPanel('plans') || hasPanel('tasks');
      allow update: if isAdmin()
        || ((hasPanel('plans')
            || hasPanel('tasks')
            || (hasPanel('myTasks')
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taskWorkflow'])))
          && request.resource.data.features.size() >= resource.data.features.size()
          && request.resource.data.get('tasks', []).size() >= resource.data.get('tasks', []).size());
    }

    match /plan_templates/{templateId} {
      allow read, write: if isAdmin() || hasPanel('plans');
    }

    match /payments/{paymentId} {
      allow read, write: if isAdmin() || hasPanel('payments');
    }

    match /performance_submissions/{submissionId} {
      allow read: if canManagePerformance() || (hasPanel('myPerformance')
        && resource.data.staffId in [request.auth.uid, request.auth.token.email]);
      allow create: if canManagePerformance();
      allow update, delete: if canManagePerformance();
    }

    match /performance_hours/{recordId} {
      allow read: if canManagePerformance() || (hasPanel('myPerformance')
        && resource.data.staffId in [request.auth.uid, request.auth.token.email]);
      allow write: if canManagePerformance();
    }

    match /performance_attendance/{recordId} {
      allow read: if canManagePerformance() || (hasPanel('myPerformance')
        && resource.data.staffId in [request.auth.uid, request.auth.token.email]);
      allow write: if canManagePerformance();
    }
  }
}
