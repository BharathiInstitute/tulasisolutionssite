{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/app",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      },
      {
        "source": "/app/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/about",
        "destination": "/about.html",
        "type": 302
      },
      {
        "source": "/services",
        "destination": "/services.html",
        "type": 302
      },
      {
        "source": "/pricing",
        "destination": "/pricing.html",
        "type": 302
      },
      {
        "source": "/how-it-works",
        "destination": "/how-it-works.html",
        "type": 302
      },
      {
        "source": "/proof",
        "destination": "/proof.html",
        "type": 302
      },
      {
        "source": "/contact",
        "destination": "/contact.html",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      }
    ],
    "cleanUrls": false,
    "trailingSlash": false
  }
}
