{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Flutter Analyze",
			"type": "shell",
			"command": "flutter analyze",
			"isBackground": false,
			"problemMatcher": [
				"$dart-build_runner"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Flutter Analyze (one-off)",
			"type": "shell",
			"command": "flutter analyze",
			"isBackground": false,
			"problemMatcher": [
				"$dart-build_runner"
			],
			"group": "build"
		},
		{
			"label": "Flutter Analyze (one-off)",
			"type": "shell",
			"command": "flutter analyze",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Flutter Analyze (one-off)",
			"type": "shell",
			"command": "flutter analyze",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Flutter Analyze (one-off)",
			"type": "shell",
			"command": "flutter analyze",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Serve Website",
			"type": "shell",
			"command": "npx --yes serve -l 8080 .",
			"options": { "cwd": "${workspaceFolder}/site" },
			"isBackground": true,
			"problemMatcher": {
				"pattern": { "regexp": "^$" },
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Serving!",
					"endsPattern": "Local:"
				}
			},
			"group": "none"
		},
		{
			"label": "Run Flutter App (web)",
			"type": "shell",
			"command": "flutter run -d chrome --web-port 5000",
			"isBackground": true,
			"problemMatcher": {
				"pattern": { "regexp": "^$" },
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Launching",
					"endsPattern": "lib/main.dart is being served"
				}
			},
			"group": "none"
		},
		{
			"label": "Run App + Site",
			"dependsOn": ["Serve Website", "Run Flutter App (web)"],
			"dependsOrder": "parallel",
			"group": "none"
		}
	]
}